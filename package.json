{
  "name": "on-track",
  "version": "0.0.5",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": "^22.16.0 || ^24.0.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  },
  "scripts": {
    "quickstart": "npm ci && npm run build && npm start",
    "dev": "concurrently -k -n api,ui \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite",
    "dev:server": "tsx watch src/server/main.ts",
    "build": "npm run clean && vite build && tsc -p tsconfig.server.json",
    "clean": "rimraf dist",
    "start": "node dist/server/server/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:migrations": "vitest run src/server/db/database.test.ts",
    "test:e2e": "npm run build && playwright test",
    "security:check": "npm audit --omit=dev --audit-level=high",
    "release:check": "node scripts/release-check.mjs",
    "verify": "npm run release:check && npm run build && npm run typecheck && npm run lint && npm run format:check && npm run test:coverage && npm run test:migrations && npm run test:e2e && npm run security:check"
  },
  "dependencies": {
    "@fastify/multipart": "9.3.0",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.3",
    "better-sqlite3": "12.10.0",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.6",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "concurrently": "10.0.5",
    "drizzle-kit": "0.31.10",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.5",
    "jsdom": "29.1.1",
    "prettier": "3.9.6",
    "rimraf": "6.1.3",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.0.16",
    "vitest": "4.1.11"
  }
}
